# Local : les deux URLs sont identiques.
# Supabase :
#   DATABASE_URL = connexion pooler (port 6543) + ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = connexion directe (port 5432), utilisée par Prisma pour db push / seed
DATABASE_URL="postgresql://fieldops:fieldops@localhost:5433/fieldops?schema=public"
DIRECT_URL="postgresql://fieldops:fieldops@localhost:5433/fieldops?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=3010
# Origine du site Netlify, séparée par des virgules si besoin
CORS_ORIGIN="http://localhost:3000"
THROTTLE_TTL=60
THROTTLE_LIMIT=20
